# ==============================================================================
# Git Ignore - AI Logistics Backend Service
# ==============================================================================

# Environment variables & secrets (NEVER commit these!)
.env
.env.*
!.env.example
*.env
*.pem
*.key
*.cert

# Python bytecode and build artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# User runtime data & chat histories (keeps local chat files private)
data/*.json
!data/.gitkeep
chat_session_*.json
*.sqlite
*.sqlite3
*.db

# Log files & scratch files
*.log
scratch/
test

# Operating system files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE & Editor files
.idea/
.vscode/
*.swp
*.swo
*~
