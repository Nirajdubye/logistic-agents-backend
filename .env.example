# ==============================================================================
# AI Business Operations Logistics Backend - Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env':
#    cp .env.example .env
# 2. Fill in your actual credentials below.
# 3. NEVER commit your real '.env' file to Git or share it publicly!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL with pgvector)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=premier_logistic
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# Optional: Full connection URL (overrides separate parameters above if provided)
# DATABASE_URL=postgresql+psycopg2://postgres:your_password@localhost:5432/premier_logistic

# ------------------------------------------------------------------------------
# 2. GOOGLE GEMINI AI CONFIGURATION
# ------------------------------------------------------------------------------
# Generate your API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Model selection (Recommended: gemini-1.5-flash or gemini-2.0-flash)
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# ------------------------------------------------------------------------------
# 3. SMTP EMAIL NOTIFICATION CONFIGURATION (Optional - for Email Agent)
# ------------------------------------------------------------------------------
# Default is Google Gmail SMTP
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Your sender email address
SMTP_EMAIL=your_email@gmail.com

# 16-character Google App Password (NOT your normal Gmail password)
# Generate at: https://myaccount.google.com/apppasswords
SMTP_PASSWORD=your_16_character_app_password

# ------------------------------------------------------------------------------
# 4. SERVER & CHAT CONFIGURATION (Optional)
# ------------------------------------------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
CHAT_THREAD_ID=default-session
